# Нужен только при запуске БЕЗ Docker (php -S ...). В Docker переменные приходят
# из compose.yaml, а корневой .env используется самим docker compose.
APP_NAME="PHP Eloquent Skeleton"
APP_ENV=local
APP_DEBUG=true

# pgsql | sqlite
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASSWORD=app_dev_password
# только для sqlite (путь от app/ или :memory:)
DB_DATABASE=database/database.sqlite

LOG_PATH=storage/logs
LOG_LEVEL=debug
LOG_MAX_FILES=14
LOG_QUERIES=true
LOG_BODY_MAX_BYTES=10240
