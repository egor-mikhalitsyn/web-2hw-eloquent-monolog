DOCKERHUB_NAMESPACE=web-2hw
IMAGE_TAG=0.1.0
COMPOSE_PROJECT_NAME=web-2hw
NGINX_PORT=8080
POSTGRES_PORT=5433
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
UID=1000
GID=1000

# --- Приложение (необязательно, значения по умолчанию заданы в compose.yaml) ---
APP_ENV=local
APP_DEBUG=true
LOG_LEVEL=debug
LOG_MAX_FILES=14
LOG_QUERIES=true
LOG_BODY_MAX_BYTES=0
